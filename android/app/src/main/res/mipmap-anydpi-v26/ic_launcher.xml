<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon, used on Android 8.0 and newer.

     foreground  → the density-specific PNG crest generated by
                   scripts/gen-icons.mjs, matching the legacy icon exactly.
     monochrome  → the flat vector, because Android 13's themed icons
                   re-colour a silhouette and a gradient would muddy it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
