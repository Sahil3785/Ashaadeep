# Copy this file to .env and fill in your Supabase project's values:
#   Supabase dashboard → Project Settings → API (or "API Keys").
#
# Both the website and the Android app read these at BUILD time, so rebuild
# (npm run build / npm run apk) after changing them.
#
# Use the anon / publishable key only. NEVER put the service_role / secret key
# here — it would ship inside the website and the APK for anyone to read.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
