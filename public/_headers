# ============================================================================
# Netlify / Cloudflare Pages response headers.
# Copied verbatim into the build output.
# ============================================================================

/*
  # Stop browsers guessing a file's type from its contents.
  X-Content-Type-Options: nosniff
  # Don't let the site be framed by someone else.
  X-Frame-Options: DENY
  # Send only the origin when leaving the site, never the full path.
  Referrer-Policy: strict-origin-when-cross-origin
  # This site needs none of these.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  # Browsers must always use HTTPS for this site.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Only load code from this site; data only from Supabase. Blocks injected scripts.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Hashed assets never change under the same name, so cache them hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The APK is replaced in place with each release, so it must NOT be cached
# hard or teachers would keep downloading an old build. The explicit
# Content-Type matters: served as text/plain, Android refuses to install it.
/downloads/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="AshaDeepFaculty.apk"
  Cache-Control: public, max-age=300, must-revalidate

/downloads/app-info.json
  Cache-Control: public, max-age=300, must-revalidate
