{
  "name": "ashadeep-school-portal",
  "private": true,
  "version": "3.0.0",
  "description": "School portal for Asha Deep Adarsh High School, Karhans (Panipat) \u2014 public website plus an Android faculty app, sharing one Supabase database.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:app": "vite --config vite.config.app.js",
    "build:app": "vite build --config vite.config.app.js",
    "sync:app": "npm run build:app && npx cap sync android",
    "apk": "npm run sync:app && cd android && ./gradlew assembleDebug",
    "check:db": "node scripts/check-db.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@supabase/supabase-js": "^2.117.2",
    "canvas-confetti": "^1.9.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.14"
  }
}
